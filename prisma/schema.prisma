generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("CUSTOMER")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String
  images         String[]
  category       String
  retailPrice    Float
  wholesalePrice Float       @default(0)
  colors         String[]
  inStock        Boolean     @default(true)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Order {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  totalAmount      Float
  phoneNumber      String
  accountReference String        @unique
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(INITIATED)
  items            OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  color     String?
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  INITIATED
  SUCCESS
  FAILED
}

enum PaymentMethod {
  MPESA_STK
  MPESA_PAYBILL
}
