generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  role      Role       @default(CUSTOMER)
  orders    Order[]
  cart      CartItem[]
  createdAt DateTime   @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String
  images         String[]
  category       String
  retailPrice    Float
  wholesalePrice Float       @default(0)
  minWholesale   Int         @default(1)
  stock          Int         @default(0)
  colors         String[]    // Example: ["#FF0000", "#000000"]
  inStock        Boolean     @default(true)
  orderItems     OrderItem[]
  cartItems      CartItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  color     String?
}

model Order {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  totalAmount      Float
  phoneNumber      String
  accountReference String        @unique
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(INITIATED)
  items            OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  color     String?
}

// ... keep your models (User, Product, etc) exactly as they are ...

// REPLACE THE BOTTOM ENUMS WITH THIS:
enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  INITIATED
  SUCCESS
  FAILED
}