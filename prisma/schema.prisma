generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  retailPrice    Float
  wholesalePrice Float
  category       String
  images         String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
